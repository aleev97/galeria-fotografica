{
  "name": "api",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply astrogaia-db --local",
    "db:seed:generate": "node scripts/generate-seed.mjs",
    "db:seed:local": "wrangler d1 execute astrogaia-db --local --file=seeds/dev.sql",
    "db:tables:local": "wrangler d1 execute astrogaia-db --local --command \"SELECT name FROM sqlite_master WHERE type='table'\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "wrangler": "^4.110.0"
  }
}
